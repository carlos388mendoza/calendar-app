# dependencies
/node_modules

# next.js
/.next/
/out/

# production (standalone) build for deployment is generated by `next build`
/.next/standalone

# local database (seed data). Never commit the generated DB.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (never commit real secrets)
.env
.env*.local
.env.development
.env.production
.env.test
# ...but keep the templates
!.env.example
!.env.production.example

# misc
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.env*
!.env.production.example
