# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para PRODUCCIÓN (Vercel)
# ─────────────────────────────────────────────────────────────────────────────
# Configúralas en cualquiera de estos sitios:
#
#   • Vercel Dashboard:
#       Tu proyecto → Settings → Environment Variables
#       (marca los entornos: Production, Preview y Development si quieres)
#
#   • Vercel CLI:
#       vercel env add TURSO_DATABASE_URL production
#       vercel env add TURSO_AUTH_TOKEN production
#
# ⚠️ NUNCA pongas valores reales en este archivo ni los subas al repositorio.
#    Es únicamente una plantilla de referencia. El archivo real que se ignora
#    por git es .env.local / .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# URL de tu base de datos Turso.
# Obténla con:  turso db show <nombre-de-tu-db> --url
TURSO_DATABASE_URL=libsql://<tu-base>-<tu-org>.turso.io

# Token de acceso de Turso.
# Créalo con:  turso db tokens create <nombre-de-tu-db>
TURSO_AUTH_TOKEN=<tu-auth-token>
